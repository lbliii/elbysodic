{
  "$schema": "https://railway.com/railway.schema.json",
  "deploy": {
    "startCommand": "elbysodic --host 0.0.0.0 --port $PORT --no-debug",
    "healthcheckPath": "/ready",
    "healthcheckTimeout": 300,
    "numReplicas": 1,
    "overlapSeconds": 5,
    "drainingSeconds": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
